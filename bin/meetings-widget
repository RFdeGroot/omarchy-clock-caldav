#!/usr/bin/env python3
"""meetings-widget: the day's agenda as JSON for the bar widget.

    meetings-widget day             # today
    meetings-widget day 1           # tomorrow, -1 is yesterday
    meetings-widget day 0 --only "Someone Else"   # that one calendar only
    meetings-widget week            # this week, Monday through Sunday
    meetings-widget week -1         # last week
    meetings-widget week --demo     # a made-up week, no calendars needed

Reads the calendars through khal, which in turn reads the local .ics files that
vdirsyncer keeps in sync with iCloud, Nextcloud or any other CalDAV server. khal
does the hard part: expanding recurring events, working out timezones and
splitting multi-day events across days.

The plugin writes its own khal config into the cache directory, pointed at the
vdir root (``calendarDir`` in the config, ``~/.calendars`` by default), so there
is no khal config for the reader to keep in step with this script.

Python rather than a shell script because the work here is dates, overlap and
JSON, and rather than Ruby because khal is itself a Python program: anyone who
can run this plugin already has the interpreter it needs.
"""

import json
import os
import re
import shutil
import subprocess
import sys
from datetime import date, datetime, timedelta

ARGV = sys.argv[1:]


def home_path(env_name, fallback, *parts):
    base = os.environ.get(env_name) or os.path.join(os.path.expanduser("~"), fallback)
    return os.path.join(base, *parts)


# Which calendar gets which colour is personal, so it lives in a config file
# instead of in here. A bar plugin cannot count on the environment reaching it,
# so a file is the only thing it can rely on; the env vars stay behind as an
# override for running this from a shell.
CONFIG_PATH = os.environ.get("MEETINGS_CONFIG") or home_path(
    "XDG_CONFIG_HOME", ".config", "calendar-caldav", "config.json")


def read_json(path, default):
    try:
        with open(path, "r") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return default


CONFIG = read_json(CONFIG_PATH, {})
if not isinstance(CONFIG, dict):
    CONFIG = {}

DEMO = ("--demo" in ARGV
        or os.environ.get("MEETINGS_DEMO") == "1"
        or CONFIG.get("demo") is True)

# What the panel remembers between openings: which calendars are ticked and
# whether you left it on the week or the day. It sits next to the config rather
# than in it, because this file is rewritten from the panel and rewriting the
# config would throw away whatever the reader put in there by hand.
STATE_PATH = os.path.join(os.path.dirname(CONFIG_PATH), "state.json")

STATE = read_json(STATE_PATH, {})
if not isinstance(STATE, dict):
    STATE = {}

# Absent means everything is shown, which is what a fresh install should do.
_visible = STATE.get("visibleCalendars")
VISIBLE = [str(name) for name in _visible] if isinstance(_visible, list) and _visible else None

# The week is the default: it says more at a glance, and it is what you get
# before you have ever chosen otherwise.
VIEW = STATE.get("view") if STATE.get("view") in ("day", "week", "month") else "week"


# The vdir root: one subdirectory per calendar, each full of .ics files, kept in
# sync by vdirsyncer. khal reads from here. Overridable so a shell can point the
# script at a throwaway tree.
CALENDAR_DIR = os.path.expanduser(
    os.environ.get("MEETINGS_CALENDAR_DIR")
    or CONFIG.get("calendarDir")
    or "~/.calendars")

# The khal config this script generates and hands to khal with -c, so the
# reader never has to write one and its date formats are known here. It lives in
# the cache directory next to calendars.json.
KHAL_CONFIG_OUT = home_path("XDG_CACHE_HOME", ".cache", "calendar-caldav", "khal.config")


def khal_config_text():
    """A discover config over the vdir root, with every date and time in a
    fixed format so the output parses without guessing."""
    return "\n".join([
        "[calendars]",
        "[[all]]",
        "path = " + os.path.join(CALENDAR_DIR, "*"),
        "type = discover",
        "color = auto",
        "",
        "[locale]",
        "timeformat = %H:%M",
        "dateformat = %Y-%m-%d",
        "longdateformat = %Y-%m-%d",
        "datetimeformat = %Y-%m-%d %H:%M",
        "longdatetimeformat = %Y-%m-%d %H:%M",
        "",
    ])


_KHAL_LAUNCHER = None


def khal_launcher():
    """How to start khal. Its launcher script is `#!/usr/bin/env python`, so a
    version manager on PATH (mise, pyenv, asdf) can shadow it with an
    interpreter that has no khal installed. Run it through one that does.
    Resolved once; None means khal is not usable from here at all."""
    global _KHAL_LAUNCHER
    if _KHAL_LAUNCHER is not None:
        return _KHAL_LAUNCHER or None

    khal = shutil.which("khal")
    if not khal:
        _KHAL_LAUNCHER = []
        return None

    for python in ("/usr/bin/python3", sys.executable, "/usr/bin/python"):
        if python and os.path.exists(python) and python != khal:
            try:
                probe = subprocess.run([python, "-c", "import khal"],
                                       stdin=subprocess.DEVNULL,
                                       stdout=subprocess.DEVNULL,
                                       stderr=subprocess.DEVNULL)
            except OSError:
                continue
            if probe.returncode == 0:
                _KHAL_LAUNCHER = [python, khal]
                return _KHAL_LAUNCHER

    # Nothing we tried could import khal; run the launcher and hope its own
    # shebang lands somewhere that works.
    _KHAL_LAUNCHER = [khal]
    return _KHAL_LAUNCHER


def helper_python():
    """The interpreter to run meetings-attendees with: it needs `icalendar`,
    which rides along with the system khal package, so reuse whatever could
    import khal."""
    launcher = khal_launcher() or []
    if len(launcher) == 2:
        return launcher[0]
    for python in ("/usr/bin/python3", "/usr/bin/python"):
        if os.path.exists(python):
            return python
    return sys.executable


def khal_argv(args):
    """khal invocation with our own config written fresh each time; it is tiny
    and this keeps it in step with the calendar dir. If the cache is not
    writable, fall back to whatever khal config the user has."""
    base = list(khal_launcher() or ["khal"])
    written = write_private(KHAL_CONFIG_OUT, khal_config_text())
    if written or os.path.isfile(KHAL_CONFIG_OUT):
        return base + ["-c", KHAL_CONFIG_OUT] + list(args)
    return base + list(args)


def khal_missing():
    return khal_launcher() is None


def calendars_present():
    """A calendar dir with at least one collection in it. Empty or absent means
    vdirsyncer has not run yet, which is a different problem from khal missing."""
    try:
        for name in os.listdir(CALENDAR_DIR):
            if name.startswith("."):
                continue  # khal's discover ignores dot-dirs; so do we
            if os.path.isdir(os.path.join(CALENDAR_DIR, name)):
                return True
    except OSError:
        pass
    return False


def vdir_stamp():
    """The newest mtime across the calendar collection directories. It moves
    when a sync adds, removes or rewrites an .ics (vdirsyncer writes atomically,
    so the containing directory changes), and stays put on a sync that found
    nothing new. The panel polls this cheaply before deciding to re-run khal."""
    latest = 0.0
    try:
        for name in os.listdir(CALENDAR_DIR):
            if name.startswith("."):
                continue
            path = os.path.join(CALENDAR_DIR, name)
            try:
                info = os.stat(path)
            except OSError:
                continue
            if os.path.isdir(path):
                latest = max(latest, info.st_mtime)
    except OSError:
        pass
    return int(latest)


def private_dir(path):
    """The directory holds what your days look like, so it is nobody else's to
    read. makedirs follows a symlink and reports success, so check the path."""
    try:
        if not os.path.isdir(path):
            os.makedirs(path, mode=0o700, exist_ok=True)
        if os.path.islink(path):
            return False
        if os.stat(path).st_uid != os.getuid():
            return False
        os.chmod(path, 0o700)
        return True
    except OSError:
        return False


def write_private(path, content):
    """rename replaces the path, where `>` would follow a symlink sitting on it."""
    directory = os.path.dirname(path)
    if not private_dir(directory):
        return False

    tmp = "%s.%d.tmp" % (path, os.getpid())
    try:
        handle = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(handle, "w") as out:
            out.write(content)
        os.rename(tmp, path)
        return True
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        return False


_skip_env = os.environ.get("MEETINGS_SKIP_CALENDARS")
SKIP_CALENDARS = [name.strip() for name in (
    _skip_env.split(",") if _skip_env is not None else (CONFIG.get("skipCalendars") or []))]

# --only turns the filter around: that one calendar becomes the only thing that
# counts. Meant for glancing at someone else's day without your own agenda in
# between, so the skip list does not apply.
ONLY_CALENDAR = None
if "--only" in ARGV:
    _index = ARGV.index("--only")
    if _index + 1 < len(ARGV):
        ONLY_CALENDAR = ARGV[_index + 1]

SKIP_TITLES = CONFIG.get("skipTitles") or []

# Colour and order per calendar. Priority decides which appointment the bar
# picks when two run at once: the lower number wins.
#
# The default is a single neutral grey, because a calendar named after someone
# else's company means nothing here. Name your own in the config file:
#
#   { "calendars": [ { "match": "Work", "color": "#4a9eff", "priority": 1 } ] }
#
# `match` is a regular expression, tried in order against the calendar name.
DEFAULT_STYLE = {"color": "#9aa0a6", "priority": 4}

CALENDAR_STYLES = []
for entry in (CONFIG.get("calendars") or []):
    try:
        CALENDAR_STYLES.append({
            "match": re.compile(str(entry.get("match", ""))),
            "color": entry.get("color") or DEFAULT_STYLE["color"],
            "priority": entry.get("priority") or DEFAULT_STYLE["priority"],
            # An explicit web app for this calendar, overriding what is worked
            # out from the sync.
            "web": str(entry.get("web") or ""),
        })
    except re.error:
        continue

# One colleague's calendar you can flip to, to see their day instead of your
# own. Without one configured the panel leaves the toggle out entirely.
#
#   { "borrowedCalendar": { "name": "Sam - Work", "label": "Sam's calendar" } }
BORROWED_CALENDAR = None
_borrowed = CONFIG.get("borrowedCalendar")
if isinstance(_borrowed, dict) and str(_borrowed.get("name") or ""):
    BORROWED_CALENDAR = {
        "name": _borrowed["name"],
        "label": _borrowed.get("label") or _borrowed["name"],
    }

# Someone else's agenda gets the neutral grey rather than a colour of its own.
# Their work appointments would otherwise get the same blue as yours, and then
# it reads as your own day; black fell so far back that the blocks stopped
# being visible at all.
BORROWED_STYLE = {"color": "#9aa0a6", "priority": 4}


# Which web app opens an appointment. Worked out per calendar from vdirsyncer's
# status, which records the CalDAV URL each local collection was synced from, so
# an iCloud calendar opens iCloud and a Nextcloud one opens that Nextcloud.
# `webCalendarUrl` in the config is the fallback and the override.
DEFAULT_WEB = str(CONFIG.get("webCalendarUrl") or "")


def _vdirsyncer_status_dir():
    config = (os.environ.get("VDIRSYNCER_CONFIG")
              or next((p for p in (os.path.expanduser("~/.vdirsyncer/config"),
                                   home_path("XDG_CONFIG_HOME", ".config", "vdirsyncer", "config"))
                       if os.path.isfile(p)), None))
    if config and os.path.isfile(config):
        try:
            with open(config) as handle:
                match = re.search(r'(?m)^\s*status_path\s*=\s*["\']?([^"\'\n]+)',
                                  handle.read())
            if match:
                path = os.path.expanduser(match.group(1).strip().strip('"\'').rstrip("/"))
                if os.path.isdir(path):
                    return path
        except OSError:
            pass
    for candidate in (os.path.expanduser("~/.vdirsyncer/status"),
                      home_path("XDG_CONFIG_HOME", ".config", "vdirsyncer", "status"),
                      home_path("XDG_DATA_HOME", ".local/share", "vdirsyncer", "status")):
        if os.path.isdir(candidate):
            return candidate
    return None


def _web_from_caldav_url(url):
    """A CalDAV endpoint -> the calendar's web app, for the servers we can name."""
    try:
        scheme, _, host = url.split("/")[0], url.split("/")[1], url.split("/")[2].lower()
    except IndexError:
        return ""
    if "icloud.com" in host:
        return "https://www.icloud.com/calendar/"
    if "google" in host or "googleusercontent" in host:
        return "https://calendar.google.com/"
    if "/remote.php/dav" in url or "/remote.php/caldav" in url:
        return "%s//%s/apps/calendar/" % (scheme, host)
    return ""


def _displayname_file(collection_id):
    try:
        with open(os.path.join(CALENDAR_DIR, collection_id, "displayname")) as handle:
            return handle.read().strip()
    except OSError:
        return ""


def web_by_calendar():
    """{display name: web app URL}. Empty when vdirsyncer's status is not where
    we look or does not parse — the config fallback then covers everything."""
    out = {}
    status = _vdirsyncer_status_dir()
    if not status:
        return out
    try:
        entries = os.listdir(status)
    except OSError:
        return out

    for name in entries:
        if not name.endswith(".collections"):
            continue
        pair = name[:-len(".collections")]
        data = read_json(os.path.join(status, name), None)
        if not isinstance(data, dict):
            continue
        for row in data.get("collections") or []:
            try:
                collection_id, sides = row[0], row[1]
            except (IndexError, TypeError, KeyError):
                continue
            remote = next((s["url"] for s in sides
                           if isinstance(s, dict) and s.get("url")), "")
            web = _web_from_caldav_url(str(remote))
            if not web:
                continue
            meta = read_json(os.path.join(status, pair, "%s.metadata" % collection_id), None)
            display = (str(meta["displayname"]) if isinstance(meta, dict) and meta.get("displayname")
                       else _displayname_file(collection_id) or str(collection_id))
            out[display] = web
    return out


CALENDAR_WEB = web_by_calendar()


def web_for(calendar):
    """The web app for one calendar: an explicit config rule first, then what
    the sync tells us, then the single fallback."""
    name = str(calendar or "")
    for style in CALENDAR_STYLES:
        if style.get("web") and style["match"].search(name):
            return style["web"]
    return CALENDAR_WEB.get(name) or DEFAULT_WEB


def style_for(calendar):
    if ONLY_CALENDAR:
        return BORROWED_STYLE

    # Without a config the demo would be three shades of the same grey, which
    # says nothing about what the colours are for.
    styles = DEMO_CALENDARS if (not CALENDAR_STYLES and DEMO) else CALENDAR_STYLES
    for style in styles:
        if style["match"].search(str(calendar or "")):
            return style
    # No rule for this calendar: the colour khal read from the server is used
    # instead, and only when that is missing too does it fall back to grey.
    return None


# A made-up week, so the widget can be tried, screenshotted and tested without
# a Google account behind it. The days are keyed by weekday, so whichever week
# you land on looks the same, and every day has something around midday for the
