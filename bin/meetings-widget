# One all-day event, on the Thursday, so the strip above the grid is not empty
# in a screenshot.
DEMO_ALLDAY = {"weekday": 3, "title": "Release day", "calendar": "Shared"}


def demo_slug(title):
    return re.sub(r"[^a-z0-9]+", "-", title.lower())


def demo_rows(from_day, to_day):
    rows = []
    day = from_day
    while day <= to_day:
        stamp = day.strftime("%Y-%m-%d")

        for start_time, end_time, title, calendar in DEMO_WEEK.get(day.weekday(), []):
            row = dict(DEMO_DETAILS.get(title, {}))
            row.update({
                "id": "demo-" + stamp + "-" + demo_slug(title),
                "start_date": stamp, "start_time": start_time,
                "end_date": stamp, "end_time": end_time,
                "title": title, "calendar": calendar,
                "hangout_link": "",
                "html_link": ("https://calendar.google.com/calendar/event?eid=demo"
                              if title in DEMO_MEET else ""),
                "conference_uri": ("https://meet.google.com/abc-defg-hij"
                                   if title in DEMO_MEET else ""),
            })
            rows.append(row)

        if day.weekday() == DEMO_ALLDAY["weekday"]:
            rows.append({
                "id": "demo-" + stamp + "-" + demo_slug(DEMO_ALLDAY["title"]),
                "start_date": stamp, "start_time": "",
                # The end date is exclusive here, so an all-day event that runs
                # for one day ends on the next.
                "end_date": (day + timedelta(days=1)).strftime("%Y-%m-%d"), "end_time": "",
                "title": DEMO_ALLDAY["title"], "calendar": DEMO_ALLDAY["calendar"],
                "html_link": "", "hangout_link": "", "conference_uri": "",
            })

        day += timedelta(days=1)
    return rows


# A URL that is on its own line, or the first video-call link in a block of
# text. The location field of an invite is often just the meeting URL; when it
# is not, the link tends to sit in the description.
URL_RE = re.compile(r"https://[^\s<>\"']+")
MEET_HOST_RE = re.compile(
    r"(?:zoom\.us|meet\.google\.com|teams\.microsoft\.com|teams\.live\.com|"
    r"teams\.microsoft\.us|whereby\.com|meet\.jit\.si|\bwebex\.com|"
    r"bluejeans\.com|gotomeeting\.com|around\.co|discord\.gg)", re.I)


def meeting_link(location, url, description):
    stripped = str(location or "").strip()
    if URL_RE.fullmatch(stripped):
        return stripped
    for text in (location, url, description):
        for candidate in URL_RE.findall(str(text or "")):
            if MEET_HOST_RE.search(candidate):
                return candidate.rstrip(").,;")
    return ""


def organizer_email(value):
    text = re.sub(r"(?i)^\s*mailto:", "", str(value or "").strip())
    match = re.search(r"([^<>()\s:]+@[^<>()\s:]+?)\s*[>)]?\s*$", text)
    return match.group(1) if match else ""


def normalize_color(value):
    """CalDAV servers, iCloud especially, hand out #RRGGBBAA. Qt reads a hex
    colour as #RRGGBB or #AARRGGBB, so the trailing alpha turns the whole thing
    into the wrong colour. Drop it."""
    text = str(value or "").strip()
    match = re.fullmatch(r"#([0-9a-fA-F]{6})[0-9a-fA-F]{2}", text)
    return "#" + match.group(1) if match else text


def row_from_khal(item):
    """One khal --json event object, turned into the row the rest of this
    script already knows how to read."""
    all_day = str(item.get("all-day", "")).strip().lower() == "true"
    start_date = str(item.get("start-date") or "")
    end_date = str(item.get("end-date") or start_date)

    if all_day:
        # khal names the last day the event covers; everything downstream here
        # follows Google's convention where the end date is the day after.
        try:
            end_date = (date.fromisoformat(end_date) + timedelta(days=1)).isoformat()
        except ValueError:
            pass
        start_time = end_time = ""
    else:
        start_time = str(item.get("start-time") or "")
        end_time = str(item.get("end-time") or "")

    location = str(item.get("location") or "")
    description = str(item.get("description") or "")
    url = str(item.get("url") or "")

    return {
        "id": str(item.get("uid") or ""),
        "title": str(item.get("title") or ""),
        "calendar": str(item.get("calendar") or ""),
        "cal_color": normalize_color(item.get("calendar-color")),
        "start_date": start_date,
        "start_time": start_time,
        "end_date": end_date,
        "end_time": end_time,
        "location": location,
        "description": description,
        # The URL property is the closest thing to a "open this event" link that
        # a CalDAV event carries.
        "html_link": url,
        "hangout_link": meeting_link(location, url, description),
        "conference_uri": "",
        "email": organizer_email(item.get("organizer")),
    }


def parse_rows(from_day, to_day):
    """khal list over the requested range. Its --json output is one JSON array
    per day, so the lines are read one by one and flattened. A recurring event
    comes back once per day it lands on, which is what the day-by-day builder
    downstream wants; a multi-day event repeats verbatim and is collapsed
    here."""
    if DEMO:
        return demo_rows(from_day, to_day)
    if khal_missing() or not calendars_present():
        return None

    span_days = (to_day - from_day).days + 1
    command = khal_argv(["list", "--json", "all",
                         from_day.strftime("%Y-%m-%d"), "%dd" % span_days])
    try:
        # stdin closed: khal has an interactive path and nothing here can answer
        # a question.
        result = subprocess.run(command, capture_output=True, text=True,
                                stdin=subprocess.DEVNULL)
    except OSError:
        return None
    if result.returncode != 0:
        return None

    rows = []
    seen = set()
    for line in result.stdout.splitlines():
        line = line.strip()
        if not line.startswith("["):
            continue
        try:
            chunk = json.loads(line)
        except ValueError:
            continue
        for item in chunk:
            if not isinstance(item, dict) or not item.get("title"):
                continue
            row = row_from_khal(item)
            key = (row["id"], row["start_date"], row["start_time"])
            if key in seen:
                continue
            seen.add(key)
            rows.append(row)
    return rows


def parse_attendees(value):
    """khal's list output has no attendees; the demo supplies them here, and the
    real ones are read from the .ics by the attendees helper. Anything that is
    not a list is ignored rather than shown half-way."""
    if not isinstance(value, list):
        return []

    people = []
    for entry in value:
        if isinstance(entry, str):
            people.append({"name": entry, "email": "", "status": ""})
            continue
        if not isinstance(entry, dict):
            continue
        name = str(entry.get("name") or entry.get("email") or "")
        if not name:
            continue
        people.append({
            "name": name,
            "email": str(entry.get("email") or ""),
            "status": str(entry.get("status") or ""),
        })
    return people


def event_from(row, day):
    start_date = row.get("start_date")
    start_time = row.get("start_time")
    end_date = row.get("end_date")
    end_time = row.get("end_time")
    title = row.get("title")
    calendar = row.get("calendar")

    # The event's own URL property, when it has one: "open this in the browser".
    link = str(row.get("html_link") or "")
    # The video-call link, pulled out of the location or description upstream.
    hangout = str(row.get("hangout_link") or "") or str(row.get("conference_uri") or "")

    # What the detail card shows. Empty stays empty: a heading with nothing
    # under it is worse than no heading.
    details = {
        "id": str(row.get("id") or ""),
        "location": str(row.get("location") or ""),
        "description": str(row.get("description") or ""),
        "organizer": str(row.get("email") or ""),
        # The web app for this calendar, for the "Open calendar" button.
        "web": web_for(calendar),
    }

    if not title:
        return None
    if title in SKIP_TITLES:
        return None

    if ONLY_CALENDAR:
        if str(calendar or "") != ONLY_CALENDAR:
            return None
    elif VISIBLE is not None:
        # Your own choice in the panel is the whole answer. Two filters side by
        # side would mean that ticking a calendar does nothing at all, and that
        # cannot be explained to anyone looking at the list.
        if str(calendar or "") not in VISIBLE:
            return None
    elif calendar in SKIP_CALENDARS:
        return None

    # A config rule wins; without one the colour is whatever khal read off the
    # server for that calendar, and grey only when there is nothing at all.
    style = style_for(calendar)
    color = (style["color"] if style
             else str(row.get("cal_color") or "") or DEFAULT_STYLE["color"])
    priority = style["priority"] if style else DEFAULT_STYLE["priority"]

    # All-day events have no time and often run across several days. row_from_khal
    # has already made the end date exclusive, the way the Google API does it.
    if not start_time:
        first = date.fromisoformat(start_date)
        last = date.fromisoformat(end_date) - timedelta(days=1)
        if not (first <= day <= last):
            return None

        event = {
            "allday": True, "title": title, "calendar": calendar,
            "color": color, "priority": priority,
            "multiday": first != last,
            "link": link,
        }
        event.update(details)
        return event

    starts = datetime.strptime("%s %s" % (start_date, start_time), "%Y-%m-%d %H:%M")
    ends = datetime.strptime("%s %s" % (end_date, end_time), "%Y-%m-%d %H:%M")
    if starts.date() != day:
        # A timed event that runs across midnight belongs on more than one day.
        # On the days after it began it goes in the all-day strip, the way
        # Google Calendar shows it: clipping it to each day's slice of the axis
        # is more clutter than the exact minutes are worth. An event that ends
        # exactly at midnight does not reach into that final day.
        last_day = ends.date()
        if ends.time() == datetime.min.time():
            last_day -= timedelta(days=1)
        if starts.date() < day <= last_day:
            event = {
                "allday": True, "title": title, "calendar": calendar,
                "color": color, "priority": priority,
                "multiday": True, "link": link,
            }
            event.update(details)
            return event
        return None

    event = {
        "allday": False,
        "title": title,
        "calendar": calendar,
        "color": color,
        "priority": priority,
        "start": starts.strftime("%H:%M"),
        "end": ends.strftime("%H:%M"),
        "start_minutes": starts.hour * 60 + starts.minute,
        "end_minutes": ends.hour * 60 + ends.minute,
        "start_epoch": int(starts.timestamp()),
        "end_epoch": int(ends.timestamp()),
        "link": link,
        "hangout": hangout,
        "minutes": round((ends - starts).total_seconds() / 60),
    }
    event.update(details)
    return event


def assign_columns(events):
    """Overlapping appointments side by side, the way a calendar does it.
    Without this they draw on top of each other and everything inside a long
    appointment disappears: a working day from 09:00 to 18:00 swallows the four
    meetings that sit within it.

    Cluster on overlap first, then take the first free column within a cluster.
    Every event carries its column and the cluster total, so the widget only
    has to divide."""
    cluster = []
    cluster_end = None

    def flush():
        columns = []
        for event in cluster:
            slot = next((i for i, free_at in enumerate(columns)
                         if free_at <= event["start_minutes"]), None)
            if slot is None:
                columns.append(event["end_minutes"])
                slot = len(columns) - 1
            else:
                columns[slot] = event["end_minutes"]
            event["column"] = slot
        for event in cluster:
            event["columns"] = len(columns)
        cluster.clear()

    for event in events:
        if cluster_end is None or event["start_minutes"] < cluster_end:
            cluster.append(event)
            cluster_end = max(cluster_end or 0, event["end_minutes"])
        else:
            flush()
            cluster.append(event)
            cluster_end = event["end_minutes"]
    flush()

    return events


def build_day(rows, day):
    """One day, assembled from the rows of the whole requested range."""
    parsed = [event for event in (event_from(row, day) for row in rows) if event]

    # Deduplicate on title plus start time: the same appointment often sits in
    # two calendars that you are both looking at.
    seen = set()
    timed = []
    for event in parsed:
        if event["allday"]:
            continue
        key = "%s|%s" % (event["title"], event["start_epoch"])
        if key in seen:
            continue
        seen.add(key)
        timed.append(event)
    timed.sort(key=lambda e: e["start_minutes"])

    return {
        # Without leading zeroes, because that is how Google Calendar wants it
        # in its url.
        "date_path": "%d/%d/%d" % (day.year, day.month, day.day),
        "date_label": day.strftime("%A %-d %B"),
        "short_label": day.strftime("%a %-d"),
        "day_label": day.strftime("%-d"),
        "is_today": day == date.today(),
        "events": assign_columns(timed),
        "allday": [event for event in parsed if event["allday"]],
    }


def upcoming_from(timed, now):
    """What the bar shows. A running appointment comes first, then the next one;
    on a tie the calendar with the highest priority wins. Only about today:
    paging a day back or forward does not change the bar."""
    stamp = int(now.timestamp())
    live = [e for e in timed if e["start_epoch"] <= stamp < e["end_epoch"]]
    if live:
        return min(live, key=lambda e: (e["priority"], e["start_epoch"]))
    ahead = [e for e in timed if e["start_epoch"] > stamp]
    if ahead:
        return min(ahead, key=lambda e: (e["start_epoch"], e["priority"]))
    return None


# The list of calendars changes about never, and asking khal for it on every
# refresh would mean a second process every minute. An hour old is fresh enough.
CACHE_PATH = home_path("XDG_CACHE_HOME", ".cache", "calendar-caldav", "calendars.json")
CACHE_MAX_AGE = 3600

DEMO_CALENDAR_NAMES = ["Work", "Personal", "Shared"]


def fetch_calendars():
    """khal printcalendars gives one display name per line. The names are the
    ones the widget shows and matches config rules against."""
    if DEMO:
        return list(DEMO_CALENDAR_NAMES)
    if khal_missing() or not calendars_present():
        return None

    try:
        result = subprocess.run(khal_argv(["printcalendars"]), capture_output=True,
                                text=True, stdin=subprocess.DEVNULL)
    except OSError:
        return None
    if result.returncode != 0:
        return None

    names = []
    for line in result.stdout.splitlines():
        name = line.strip()
        if name and name not in names:
            names.append(name)
    return sorted(names)


def cached_calendars():
    """A cache must never be the thing that breaks the script, so anything that
    is not the shape we wrote is treated as no cache at all."""
    # The demo's calendar names must never reach the on-disk cache, or a single
    # --demo run leaves the real panel showing Work/Personal/Shared for an hour.
    if DEMO:
        return fetch_calendars() or []

    try:
        if (os.path.isfile(CACHE_PATH) and not os.path.islink(CACHE_PATH)
                and (datetime.now().timestamp() - os.path.getmtime(CACHE_PATH)) < CACHE_MAX_AGE):
            parsed = read_json(CACHE_PATH, None)
            if isinstance(parsed, list) and parsed:
                return [str(name) for name in parsed]
    except OSError:
        pass  # fall through and ask khal again

    fresh = fetch_calendars()
    if not fresh:
        return []

    write_private(CACHE_PATH, json.dumps(fresh))
    return fresh


def dump(payload):
    sys.stdout.write(json.dumps(payload) + "\n")


def main():
    # Two commands the panel calls directly, both outside the agenda path.
    command = ARGV[0] if ARGV else ""

    if command == "calendars":
        dump(cached_calendars())
        return 0

    if command == "stamp":
        # Cheap: no khal, just a stat of the calendar dirs. The panel polls this
        # every minute and only re-runs khal when it moved.
        dump({"stamp": 0 if DEMO else vdir_stamp()})
        return 0

    if command == "attendees":
        # One appointment, asked for at the moment you open it. Reading every
        # .ics on every refresh would be a lot of file work for something you
        # only ever see when you ask for it.
        calendar_name = ARGV[1] if len(ARGV) > 1 else ""
        event_id = ARGV[2] if len(ARGV) > 2 else ""

        if DEMO:
            for title, details in DEMO_DETAILS.items():
                if event_id.endswith("-" + demo_slug(title)):
                    dump(parse_attendees(details.get("attendees")))
                    return 0
            dump([])
            return 0

        if not event_id:
            dump([])
            return 0

        helper = os.path.join(os.path.dirname(os.path.abspath(__file__)), "meetings-attendees")
        try:
            # The argument list goes straight to the process, so no shell is
            # involved that could split a calendar name with a space in it. The
            # helper finds the .ics itself; the vdir root is handed along so it
            # does not have to guess.
            env = dict(os.environ, MEETINGS_CALENDAR_DIR=CALENDAR_DIR)
            result = subprocess.run([helper_python(), helper, calendar_name, event_id],
                                    capture_output=True, text=True, env=env)
            sys.stdout.write(result.stdout if result.returncode == 0 and result.stdout.strip()
                             else '{"attendees": [], "conference": ""}\n')
        except OSError:
            sys.stdout.write('{"attendees": [], "conference": ""}\n')
        return 0

    if command == "set-view":
        wanted = ARGV[1] if (len(ARGV) > 1 and ARGV[1] in ("day", "week", "month")) else "week"
        merged = dict(STATE)
        merged["view"] = wanted
        dump({"ok": write_private(STATE_PATH, json.dumps(merged)), "view": wanted})
        return 0

    if command == "set-calendars":
        # Everything after the command is a calendar name. An empty list would
        # mean an empty grid with no way back from the panel, so it is stored as
        # "all of them" instead, which is also what a fresh install shows.
        chosen = [name for name in ARGV[1:] if name]
        merged = dict(STATE)
        merged["visibleCalendars"] = chosen
        ok = write_private(STATE_PATH, json.dumps(merged))
        dump({"ok": ok, "visible": chosen or None})
        return 0

    mode = command if command in ("week", "month") else "day"
    second = ARGV[1] if len(ARGV) > 1 else ""
    try:
        offset = 0 if second.startswith("--") else int(second or 0)
    except ValueError:
        offset = 0
    now = datetime.now()
    today = date.today()

    month_first = None
    if mode == "week":
        # The offset counts in weeks and the week starts on Monday, the way
        # Google Calendar does it.
        monday = today - timedelta(days=today.weekday()) + timedelta(days=offset * 7)
        days = [monday + timedelta(days=n) for n in range(7)]
    elif mode == "month":
        # The offset counts in months. The grid runs from the Monday on or
        # before the 1st to the Sunday on or after the last day: four to six
        # whole weeks, the way a wall calendar is laid out.
        month_index = today.year * 12 + (today.month - 1) + offset
        month_first = date(month_index // 12, month_index % 12 + 1, 1)
        if month_first.month == 12:
            month_last = date(month_first.year, 12, 31)
        else:
            month_last = date(month_first.year, month_first.month + 1, 1) - timedelta(days=1)
        grid_start = month_first - timedelta(days=month_first.weekday())
        grid_end = month_last + timedelta(days=6 - month_last.weekday())
        days = [grid_start + timedelta(days=n)
                for n in range((grid_end - grid_start).days + 1)]
    else:
        days = [today + timedelta(days=offset)]

    rows = parse_rows(days[0], days[-1])
    if rows is None:
        # Three problems, three answers: install khal, set up the sync, or khal
        # is there but choked on something.
        if khal_missing():
            error = "khal-missing"
        elif not calendars_present():
            error = "no-calendars"
        else:
            error = "khal-failed"
        dump({"ok": False, "error": error,
              "events": [], "allday": [], "days": []})
        return 0

    built = [build_day(rows, day) for day in days]
    today_built = next((d for d in built if d["is_today"]), None)

    if mode == "month":
        # The leading and trailing days belong to the neighbouring months and
        # are drawn dimmed, so the panel needs to know which is which.
        for day, entry in zip(days, built):
            entry["in_month"] = day.month == month_first.month

    # The bar is always about today and about your own calendar; paging around,
    # or looking at someone else's week, must not change it.
    upcoming = (upcoming_from(today_built["events"], now)
                if ONLY_CALENDAR is None and today_built else None)

    known = cached_calendars()
    payload = {
        "ok": True,
        "mode": mode,
        "offset": offset,
        "only_calendar": ONLY_CALENDAR,
        # The panel needs to know whether there is a colleague's calendar to
        # borrow before it can decide whether to draw the toggle for it, and the
        # config file is the only place that knows. Sending it along beats
        # teaching the QML to read the file a second time.
        "borrowed": BORROWED_CALENDAR,
        # The panel draws the calendar picker from these two: everything there
        # is, and what is ticked. A null selection means nothing has been
        # unticked yet, and the panel then shows them all as on.
        "calendars": known,
        # With no choice of your own the starting position is everything except
        # what the config skips, and that is exactly what the boxes have to show.
        "visible": VISIBLE if VISIBLE is not None
                   else [name for name in known if name not in SKIP_CALENDARS],
        "view": VIEW,
        # The calendar behind a click on the date header. There is no per-day
        # deep link, so it is one base URL: the configured one, or the shared
        # one when every synced calendar lives on the same server.
        "web_base": DEFAULT_WEB or (
            next(iter(set(CALENDAR_WEB.values())))
            if len(set(CALENDAR_WEB.values())) == 1 else ""),
        "now": now.strftime("%H:%M"),
        "now_minutes": now.hour * 60 + now.minute,
        # So the panel knows what state of the calendar this answer reflects and
        # can tell when a later `stamp` means something moved.
        "stamp": vdir_stamp() if not DEMO else 0,
        "upcoming": upcoming,
        "days": built,
    }

    if mode == "week":
        # Google's week view uses the Monday as its anchor.
        payload["date_path"] = built[0]["date_path"]
        payload["date_label"] = "%s - %s" % (days[0].strftime("%-d %b"),
                                             days[-1].strftime("%-d %b"))
        payload["is_today"] = offset == 0
    elif mode == "month":
        payload["date_path"] = "%d/%d/1" % (month_first.year, month_first.month)
        payload["date_label"] = month_first.strftime("%B %Y")
        payload["is_today"] = offset == 0
    else:
        for key in ("date_path", "date_label", "is_today", "events", "allday"):
            payload[key] = built[0][key]

    dump(payload)
    return 0


if __name__ == "__main__":
    sys.exit(main())
